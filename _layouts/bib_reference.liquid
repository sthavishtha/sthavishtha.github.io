---
---
{%- comment -%}
  Compact APA-style reference line, rendered as a numbered list item.
  Used by the project pages via:
    {% bibliography --query @*[key=some_key] --template bib_reference %}
  wrapped in <div class="publications reference-list">.
  The full card layout with previews and badges lives in bib.liquid.
{%- endcomment -%}
{%- assign author_count = entry.author_array | size -%}
{%- comment -%}
  Link the title to the DOI (or arXiv) exactly as the publications page does.
{%- endcomment -%}
{%- capture linked_title -%}
  {%- if entry.doi -%}
    <a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener noreferrer">{{ entry.title }}</a>
  {%- elsif entry.arxiv -%}
    <a href="https://arxiv.org/abs/{{ entry.arxiv }}" target="_blank" rel="noopener noreferrer">{{ entry.title }}</a>
  {%- else -%}
    {{- entry.title -}}
  {%- endif -%}
{%- endcapture -%}
<span id="{{ entry.key }}" class="reference">
  {%- if author_count > 0 -%}
    {%- for author in entry.author_array -%}
      {%- if forloop.last and author_count > 1 %}&amp; {% endif -%}
      {{- author.last -}},
      {%- assign given_names = author.first | split: ' ' -%}
      {%- for given in given_names %} {{ given | slice: 0 }}.{% endfor -%}
      {%- unless forloop.last %}, {% endunless -%}
    {%- endfor -%}
    {%- if entry.year %} ({{ entry.year }}){% endif -%}.
    {{ linked_title }}.
  {%- else -%}
    {{ linked_title }}
    {%- if entry.year %} ({{ entry.year }}){% endif -%}.
  {%- endif -%}
  {%- if entry.journal %}
    <em>{{ entry.journal }}</em>
    {%- if entry.volume %}, <em>{{ entry.volume }}</em>{% endif -%}
    {%- if entry.number %}({{ entry.number }}){% endif -%}
    {%- if entry.pages %}, {{ entry.pages | replace: '--', '–' }}{% endif -%}.
  {%- elsif entry.booktitle %}
    In <em>{{ entry.booktitle }}</em>
    {%- if entry.pages %} (pp. {{ entry.pages | replace: '--', '–' }}){% endif -%}.
  {%- endif -%}
</span>
